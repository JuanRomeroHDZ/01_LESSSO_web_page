# ==============================================================================
# LESSSO - VARIABLES DE ENTORNO CENTRALIZADAS
# Arquitectura: Frontend (Next.js) + Backend (Fastify) + Base de Datos (PostgreSQL) + Redis + CRM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO GENERAL Y PUERTOS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT_FRONTEND=3000
PORT_BACKEND=4000
PORT_DATABASE=5432
PORT_REDIS=6379

# ------------------------------------------------------------------------------
# 2. CONFIGURACION DE URLS Y DOMINIOS
# ------------------------------------------------------------------------------
# URL publica del frontend para politicas CORS y redirecciones
FRONTEND_URL=http://localhost:3000

# URL de la API backend consumida por el frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://lessso-back:4000

# Clave secreta para tokens internos de sesion o hash de seguridad
APP_SECRET=lessso_super_secure_production_secret_key_change_in_prod_12345

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (Drizzle ORM)
# ------------------------------------------------------------------------------
POSTGRES_USER=lessso_admin
POSTGRES_PASSWORD=lessso_secure_db_password_change_me
POSTGRES_DB=lessso_production
POSTGRES_HOST=lessso-db
POSTGRES_PORT=5432

# Cadena de conexion completa para Drizzle ORM
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://lessso_admin:lessso_secure_db_password_change_me@lessso-db:5432/lessso_production

# ------------------------------------------------------------------------------
# 4. CACHE Y RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=lessso-redis
REDIS_PORT=6379
REDIS_PASSWORD=lessso_redis_secure_password_change_me

# Cadena de conexion completa de Redis
REDIS_URL=redis://:lessso_redis_secure_password_change_me@lessso-redis:6379

# ------------------------------------------------------------------------------
# 5. SEGURIDAD Y REGLAS DE CONTACTO
# ------------------------------------------------------------------------------
# Tiempo de cooldown en segundos tras envio exitoso del formulario
COOLDOWN_SECONDS=90

# Limite maximo de solicitudes por ventana de rate limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Campo honeypot anti-spam (debe mantenerse invisible en el frontend)
HONEYPOT_FIELD_NAME=website_verification_code

# ------------------------------------------------------------------------------
# 6. INTEGRACION CON TWENTY CRM (Autoalojado o Cloud)
# ------------------------------------------------------------------------------
# URL base de la instancia de Twenty CRM (dejar vacio si aun no esta desplegado)
TWENTY_API_URL=http://lessso-crm:3001/graphql

# Token de autorizacion de Twenty CRM (Bearer Token o API Key)
# Si se deja vacio, el backend almacenara los prospectos en PostgreSQL con estado PENDING
TWENTY_API_KEY=

# ------------------------------------------------------------------------------
# 7. COMUNICACIONES Y CONTACTO CORPORATIVO
# ------------------------------------------------------------------------------
# Correo electronico oficial que recibe notificaciones de nuevos prospectos
OFFICIAL_CONTACT_EMAIL=contacto@lessso.com

# Numero de WhatsApp corporativo en formato internacional (sin signos ni espacios)
# Ejemplo para Mexico (+52): 5215512345678
WHATSAPP_PHONE_NUMBER=5215500000000
