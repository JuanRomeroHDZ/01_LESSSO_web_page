# ==============================================================================
# LESSSO - VARIABLES DE ENTORNO CENTRALIZADAS
# Arquitectura: Frontend (Next.js) + Backend (Fastify) + Redis (Rate Limit / Cooldown)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO GENERAL Y PUERTOS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT_FRONTEND=3000
PORT_BACKEND=4000
PORT_REDIS=6379

# ------------------------------------------------------------------------------
# 2. CONFIGURACION DE URLS Y DOMINIOS
# ------------------------------------------------------------------------------
# URL publica del frontend para politicas CORS y redirecciones
FRONTEND_URL=http://localhost:3000

# URL de la API backend consumida por el frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://lessso-back:4000

# Clave secreta para tokens internos de sesion o hash de seguridad
APP_SECRET=lessso_super_secure_production_secret_key_change_in_prod_12345

# ------------------------------------------------------------------------------
# 3. CACHE Y RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=lessso-redis
REDIS_PORT=6379
REDIS_PASSWORD=lessso_redis_secure_password_change_me

# Cadena de conexion completa de Redis
REDIS_URL=redis://:lessso_redis_secure_password_change_me@lessso-redis:6379

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y REGLAS DE CONTACTO
# ------------------------------------------------------------------------------
# Tiempo de cooldown en segundos tras envio exitoso del formulario
COOLDOWN_SECONDS=90

# Limite maximo de solicitudes por ventana de rate limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15

# Campo honeypot anti-spam (debe mantenerse invisible en el frontend)
HONEYPOT_FIELD_NAME=website_verification_code

# ------------------------------------------------------------------------------
# 5. COMUNICACIONES Y CANAL DIRECTO DE WHATSAPP
# ------------------------------------------------------------------------------
# Correo electronico oficial que recibe notificaciones de nuevos prospectos
OFFICIAL_CONTACT_EMAIL=contacto@lessso.com

# Numero oficial de WhatsApp (10 digitos local, 12 con lada Mexico, maximo 15 digitos)
WHATSAPP_PHONE_NUMBER=526642276711
NEXT_PUBLIC_WHATSAPP_NUMBER=526642276711

# Activación futura del formulario y documentos legales (desactivados por defecto).
# NEXT_PUBLIC_CONTACT_FORM_ENABLED=true
# NEXT_PUBLIC_LEGAL_PAGES_ENABLED=true
# CONTACT_FORM_ENABLED=true
# NEXT_PUBLIC_BACKEND_URL=https://api.example.com
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=correo-completo@example.com
# SMTP_PASSWORD=contraseña-de-aplicacion
# SMTP_FROM=correo-completo@example.com

# Solo IPs exactas de proxies propios y controlados, separadas por comas.
# TRUSTED_PROXY_IPS=192.0.2.10
